# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investresearch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Test database (separate service/database so tests never touch dev data)
TEST_POSTGRES_DB=investresearch_test

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
QLIB_DATA_DIR=/app/var/qlib-data
RESEARCH_ARTIFACT_DIR=/app/var/research-artifacts
QLIB_DISK_BUDGET_BYTES=21474836480
QLIB_THREADS=2

# Frontend
# Browser-side calls (must be publicly reachable from the host):
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side (SSR/route handler) calls, over the compose-internal network:
API_URL=http://backend:8000

# J-Quants API (choose exactly one; file path must be readable in the backend/worker containers)
# JQUANTS_API_KEY=
# JQUANTS_API_KEY_FILE=/run/secrets/jquants_api_key
