# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investresearch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Test database (separate service/database so tests never touch dev data)
TEST_POSTGRES_DB=investresearch_test

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend
# Browser-side calls (must be publicly reachable from the host):
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side (SSR/route handler) calls, over the compose-internal network:
API_URL=http://backend:8000

# J-Quants API (set once ticket 03 implements the sync adapter)
# JQUANTS_API_KEY=
